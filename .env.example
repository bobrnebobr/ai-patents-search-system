APP_VERSION=0.1.0
APP_COMMIT_SHA=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_patent_search
LOG_LEVEL=INFO
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
RUSTFS_ENDPOINT=https://s3.example.com
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=datasets
MLFLOW_TRACKING_URI=https://mlflow.example.com
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Use http://ml:8080 when the backend runs inside Docker Compose.
MLSERVER_URL=http://localhost:8080
ENCODER_MODEL_NAME=patent-bi-encoder
MLSERVER_TIMEOUT=60

# HTTPS reverse proxy: use port 443, not Qdrant's default port 6333.
QDRANT_URL=https://qdrant.176-108-247-200.sslip.io
QDRANT_PORT=443
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_TIMEOUT=300
